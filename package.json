    "@radix-ui/react-tooltip": "^1.2.6",
    "@wxt-dev/storage": "^1.1.1",
    "@wxt-dev/webextension-polyfill": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.526.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.3",
